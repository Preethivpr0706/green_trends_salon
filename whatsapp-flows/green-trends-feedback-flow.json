{
  "version": "7.3",
  "routing_model": {
    "FEEDBACK_RATES": ["FEEDBACK_COMMENT"],
    "FEEDBACK_COMMENT": []
  },
  "screens": [
    {
      "id": "FEEDBACK_RATES",
      "title": "Green Trends — Feedback 1/2",
      "data": {
        "feedback_channel": {
          "type": "string",
          "__example__": "whatsapp"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              { "type": "TextBody", "text": "UNISEX HAIR & STYLE SALON" },
              { "type": "TextBody", "text": "Help us improve — a few quick questions 💚" },
              {
                "type": "TextSubheading",
                "text": "How would you rate your overall experience at Green Trends?"
              },
              {
                "type": "TextBody",
                "text": "1 = Poor · 5 = Excellent"
              },
              {
                "type": "Dropdown",
                "label": "Overall experience",
                "name": "overall_experience",
                "required": true,
                "data-source": [
                  { "id": "5_Excellent", "title": "⭐⭐⭐⭐⭐ · Excellent (5/5)" },
                  { "id": "4_Good", "title": "⭐⭐⭐⭐☆ · Good (4/5)" },
                  { "id": "3_Average", "title": "⭐⭐⭐☆☆ · Average (3/5)" },
                  { "id": "2_Poor", "title": "⭐⭐☆☆☆ · Poor (2/5)" },
                  { "id": "1_Very_Poor", "title": "⭐☆☆☆☆ · Very poor (1/5)" }
                ]
              },
              {
                "type": "TextSubheading",
                "text": "How satisfied are you with our staff’s professionalism and behavior?"
              },
              {
                "type": "Dropdown",
                "label": "Staff service",
                "name": "staff_service",
                "required": true,
                "data-source": [
                  { "id": "5_Excellent", "title": "⭐⭐⭐⭐⭐ · Excellent (5/5)" },
                  { "id": "4_Good", "title": "⭐⭐⭐⭐☆ · Good (4/5)" },
                  { "id": "3_Average", "title": "⭐⭐⭐☆☆ · Average (3/5)" },
                  { "id": "2_Poor", "title": "⭐⭐☆☆☆ · Poor (2/5)" },
                  { "id": "1_Very_Poor", "title": "⭐☆☆☆☆ · Very poor (1/5)" }
                ]
              },
              {
                "type": "TextSubheading",
                "text": "Did our stylist understand your requirement and deliver the expected result?"
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Service quality",
                "name": "service_quality",
                "required": true,
                "data-source": [
                  { "id": "fully_satisfied", "title": "Yes, fully satisfied" },
                  { "id": "partially_satisfied", "title": "Partially satisfied" },
                  { "id": "not_satisfied", "title": "Not satisfied" }
                ]
              },
              {
                "type": "TextSubheading",
                "text": "How do you feel about our pricing compared to the service provided?"
              },
              {
                "type": "RadioButtonsGroup",
                "label": "Value for money",
                "name": "value_for_money",
                "required": true,
                "data-source": [
                  { "id": "worth_it", "title": "Worth it" },
                  { "id": "average_value", "title": "Average" },
                  { "id": "not_worth_it", "title": "Not worth it" }
                ]
              },
              {
                "type": "Footer",
                "label": "Continue",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "FEEDBACK_COMMENT"
                  },
                  "payload": {
                    "overall_experience": "${form.overall_experience}",
                    "staff_service": "${form.staff_service}",
                    "service_quality": "${form.service_quality}",
                    "value_for_money": "${form.value_for_money}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "FEEDBACK_COMMENT",
      "title": "Green Trends — Feedback 2/2",
      "terminal": true,
      "success": true,
      "data": {
        "overall_experience": {
          "type": "string",
          "__example__": "5_Excellent"
        },
        "staff_service": {
          "type": "string",
          "__example__": "5_Excellent"
        },
        "service_quality": {
          "type": "string",
          "__example__": "fully_satisfied"
        },
        "value_for_money": {
          "type": "string",
          "__example__": "worth_it"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "form",
            "children": [
              { "type": "TextBody", "text": "UNISEX HAIR & STYLE SALON" },
              {
                "type": "TextSubheading",
                "text": "What can we improve to serve you better?"
              },
              {
                "type": "TextArea",
                "label": "Your suggestion (optional)",
                "required": false,
                "name": "improvement_suggestion"
              },
              {
                "type": "Footer",
                "label": "Submit",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "overall_experience": "${data.overall_experience}",
                    "staff_service": "${data.staff_service}",
                    "service_quality": "${data.service_quality}",
                    "value_for_money": "${data.value_for_money}",
                    "improvement_suggestion": "${form.improvement_suggestion}"
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
